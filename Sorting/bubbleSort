#include<stdio.h>                                                                                   
void bubbleSort(int a[],int n){
    for(int i=0;i<n;i++){
        for(int j = 0;j<n-i-1;j++){
            if(a[j]>a[j+1]){
                int temp = a[j];
                a[j]=a[j+1];
                a[j+1]=temp;
            }
        }
    }
}
int main(){
    int n = 6;
    int a[] = {9,5,3,1,6,2};
    bubbleSort(a,n);
    for(int i=0;i<n;i++){
        printf("%d",a[i]);
    }
    printf("\n");
    return 0;
}
