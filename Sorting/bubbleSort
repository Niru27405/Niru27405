#include<stdio.h>                                                                                   
void bubbleSort(int a[],int n){
    for(int i=0;i<n;i++){
        int flag = 0;
        for(int j = 0;j<n-i-1;j++){
            if(a[j]>a[j+1]){
                int temp = a[j];
                a[j]=a[j+1];
                a[j+1]=temp;
                flag = 1;
            }
        }if(flag == 0)break;
    }
}
int main(){
    int n = 6;
    int a[] = {1,2,3,4,5,6};
    bubbleSort(a,n);
    for(int i=0;i<n;i++){
        printf("%d ",a[i]);
    }
    printf("\n");
    return 0;
}
